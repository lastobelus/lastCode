#!/usr/bin/env sh
git_local_env=$(git rev-parse --local-env-vars) || exit 1
unset $git_local_env
unset git_local_env
vp run --workspace-root lastcode:ci:quick -- --pre-push
validation_status=$?
# A rejected hook proves Git has not started updating remote refs.
if [ "$validation_status" -ne 0 ] && [ -n "${LASTCODE_MAIN_WRITE_HOOK_RECEIPT:-}" ]; then
  (umask 077; printf 'rejected\n' > "$LASTCODE_MAIN_WRITE_HOOK_RECEIPT") || :
fi
exit "$validation_status"
