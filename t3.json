{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "id": "lc-wait-for-pr",
      "name": "Wait for PR",
      "command": "mise exec node@24.13.1 -- node scripts/lastcode-wait-for-pr.ts",
      "icon": "test"
    },
    {
      "id": "lc-wait-for-checkpoint",
      "name": "Wait for Checkpoint",
      "command": "mise exec node@24.13.1 -- node \"$T3CODE_PROJECT_ROOT/scripts/lastcode-wait-for-checkpoint.ts\"",
      "icon": "test"
    },
    {
      "id": "lc-local-ci",
      "name": "Run Quick CI",
      "command": "mise exec node@24.13.1 -- node scripts/lastcode-local-ci.ts --quick",
      "icon": "test"
    },
    {
      "id": "lc-build-local-package",
      "name": "Build Local Package",
      "command": "mise exec node@24.13.1 -- node \"$T3CODE_PROJECT_ROOT/scripts/lastcode-build-local-package.ts\" run",
      "icon": "build"
    },
    {
      "id": "lc-build-intel-package",
      "name": "Build Intel package (macOS)",
      "command": "mise exec node@24.13.1 -- node scripts/lastcode-build-intel-package.ts run",
      "icon": "build"
    }
  ]
}
