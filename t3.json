{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "mise exec node@24.13.1 -- node -e \"const r=require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.T3CODE_PROJECT_ROOT,'scripts','setup-worktree.ts')],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1);\"",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "id": "lc-prepare-dependencies",
      "name": "Prepare Dependencies",
      "command": "mise exec node@24.13.1 -- node -e \"const r=require('node:child_process').spawnSync(process.execPath,[require('node:path').join(process.env.T3CODE_PROJECT_ROOT,'scripts','prepare-dependencies.ts')],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1);\"",
      "icon": "configure"
    },
    {
      "id": "lc-local-ci",
      "name": "Run Quick CI",
      "command": "mise exec node@24.13.1 -- node -e \"for(const args of [[require('node:path').join(process.env.T3CODE_PROJECT_ROOT,'scripts','prepare-dependencies.ts'),'--for-ci'],['scripts/lastcode-local-ci.ts','--quick']]){const r=require('node:child_process').spawnSync(process.execPath,args,{stdio:'inherit'});if(r.error)console.error(r.error.message);if(r.status===0)continue;process.exit(r.status??1);}\"",
      "icon": "test"
    },
    {
      "id": "lc-build-local-package",
      "name": "Build Local Package",
      "command": "mise exec node@24.13.1 -- node \"$T3CODE_PROJECT_ROOT/scripts/lastcode-build-local-package.ts\" run",
      "icon": "build"
    },
    {
      "id": "lc-build-intel-package",
      "name": "Build Intel package (macOS)",
      "command": "mise exec node@24.13.1 -- node scripts/lastcode-build-intel-package.ts run",
      "icon": "build"
    }
  ]
}
